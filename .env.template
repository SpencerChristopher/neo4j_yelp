# Neo4j Credentials - DO NOT commit real secrets to this file
# Copy this file to .env and fill in the actual values.
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_strong_neo4j_password_here

# Neo4j Read-only User Credentials
NEO4J_READ_USER=neo4j_read
NEO4J_READ_PASSWORD=your_strong_neo4j_read_password_here

# Neo4j LOAD CSV import subdirectory (under /var/lib/neo4j/import)
# For tests with mounted test data, set to: test_data
# Leave empty for production data mounted at the import root.
NEO4J_IMPORT_SUBDIR=



